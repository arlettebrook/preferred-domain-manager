{
  "name": "preferred-domain-manager",
  "version": "1.0.0",
  "private": true,
  "description": "优选域名管理面板：Cloudflare Workers DNS 优选 IP 管理器",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "npm run typecheck",
    "test": "node --test scripts/core.test.mjs",
    "test:integration": "node --test scripts/api.integration.test.mjs",
    "test:browser": "node --test scripts/browser-smoke.test.mjs",
    "typecheck": "tsc --noEmit",
    "check:ui": "node scripts/check-ui.mjs",
    "check": "npm run typecheck && npm run check:ui && wrangler deploy --dry-run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260730.1",
    "typescript": "^5.8.3",
    "wrangler": "^4.114.0"
  }
}
